NEXT_PUBLIC_SUPABASE_URL=https://pfsxuylbnpbcgjehuaqo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional — scripts/apply-migrations.mjs
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production must be the real host, e.g. https://optical-center-rose.vercel.app
# (localhost here breaks Magic Link emails if baked into Vercel builds)
NEXT_PUBLIC_DEFAULT_LOCALE=he
# Pilot password login (set on the Auth user via seed / admin update)
# Also enables /login password tab fallback when Supabase Auth is unreachable.
PILOT_LOGIN_PASSWORD=
# Optional: send production Magic Links via Resend (bypasses broken Site URL)
RESEND_API_KEY=
LOGIN_EMAIL_FROM=
# Optional: Supabase Management API token to fix Site URL
# SUPABASE_ACCESS_TOKEN=
#   node --env-file=.env.local scripts/fix-supabase-auth-urls.mjs
# WhatsApp Business display number for QR/NFC wa.me links (digits only, country code)
NEXT_PUBLIC_WA_BUSINESS_PHONE=
# Meta Cloud API (must match code: WHATSAPP_*)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Demo technician profile UUID (see seed_demo_technicians migration)
DEMO_TECH_ID=11111111-1111-4111-8111-111111111111
# Force in-memory backend even if Supabase is reachable
MAINTAINOS_FORCE_MEMORY=
# Allow mos_test_actor / test bearer (QA / Playwright)
MAINTAINOS_ALLOW_TEST_AUTH=
# Optional client-visible demo entry on /login (alternative to server flags)
# Shows one-click "כניסה כדמו · OpsBrain1@gmail.com" when set to 1
NEXT_PUBLIC_MAINTAINOS_DEMO_ENTRY=
# Google OAuth (recommended for HQ / stores / tech)
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=1
# Comma-separated emails allowed to sign in (in addition to provisioned profiles)
# APPROVED_LOGIN_EMAILS=OpsBrain1@gmail.com,tech@optical-center.co.il
# Enable Google provider in Supabase Dashboard → Authentication → Providers
# Seed pilot owner (Auth + profile + global_admin):
#   node --env-file=.env.local scripts/seed-pilot-user.mjs
# Vercel cron /api/cron/sla-escalation (Bearer or CRON_SECRET / x-cron-secret header)
CRON_SECRET=
# Optional WhatsApp for SLA manager alerts (logged if unset)
SLA_MANAGER_PHONE=
# WhatsApp AI — Vercel AI Gateway ONLY (package `ai`)
# Enable AI Gateway in Vercel project, then:
#   vercel env pull   → VERCEL_OIDC_TOKEN
# or set AI_GATEWAY_API_KEY=
WHATSAPP_AI_ENABLED=
AI_GATEWAY_API_KEY=
# Optional Gateway model slugs (provider/model):
WHATSAPP_AI_MODEL=
WHATSAPP_AI_INTAKE_ENABLED=
WHATSAPP_AI_INTAKE_MODEL=
# Force sync webhook processing (tests / local); production uses after()
WHATSAPP_WEBHOOK_SYNC=
# Optional Sentry DSN — thin captureError() in src/lib/monitoring.ts (no @sentry/nextjs)
SENTRY_DSN=
# 019SMS — technician assign alerts (Bamakor-style SMS primary)
# Dashboard: https://019sms.co.il — generate API token in account settings
SMS_019_USERNAME=
# Sender "source" registered in 019 (max 11 chars, no +).
# Optical: same line as WhatsApp (+972 55-281-9086) → use local form approved in 019:
SMS_019_SENDER=0552819086
# Preferred auth (Bearer):
SMS_019_TOKEN=
# Legacy auth (only if no token): SMS_019_PASSWORD=
# SMS_019_TEST=1          # use /api/test (no real delivery)
# SMS_019_DRY_RUN=1       # log only, skip HTTP

