{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/sla-escalation",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/unassigned-timeout",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/monthly-report",
      "schedule": "0 6 1 * *"
    }
  ]
}
